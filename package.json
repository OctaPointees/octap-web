{
  "name": "octap-web",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w @octap/admin",
    "dev:business": "npm run dev -w @octap/business",
    "dev:landing": "npm run dev -w @octap/landing",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "@octap/shared": "*"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "typescript": "~6.0.2"
  }
}
