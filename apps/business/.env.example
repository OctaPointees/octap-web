VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# Vite development proxy target. Production must route /v1/console to Core too.
CORE_API_URL=http://127.0.0.1:3000
# Leave empty for the same-origin proxy; use an HTTPS Core base URL if deployed separately.
VITE_CORE_API_URL=
# Explicit opt-in to the old password/mock screens. Keep false for real Google login.
VITE_ENABLE_DEMO_AUTH=false

# Existing System Admin application
VITE_ADMIN_PORTAL_URL=http://localhost:5000/admin

# Not operational by default; enable only together with Core ORG_SLUG_ENTRY_ENABLED.
VITE_ENABLE_ORG_SLUG_ENTRY=false
